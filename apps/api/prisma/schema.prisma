generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  CUSTOMER
  STAFF
  MANAGER
}
enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}
enum PaymentMethod {
  MOCK_WALLET
  MOCK_CARD
}
enum LoyaltyType {
  EARN
  REDEEM
}
model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  name String
  role Role @default(CUSTOMER)
  createdAt DateTime @default(now())
  orders Order[]
  loyalty LoyaltyTransaction[]
  stockMovements StockMovement[]
  statusChanges OrderStatusHistory[] @relation("OrderStatusChangedBy")
}
model Product {
  id String @id @default(uuid())
  slug String @unique
  name String
  description String
  category String
  image String?
  active Boolean @default(true)
  inventory Int @default(100)
  sizes ProductSize[]
  toppings ProductTopping[]
  orderItems OrderItem[]
  createdAt DateTime @default(now())
}
model ProductSize {
  id String @id @default(uuid())
  name String
  priceCents Int
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipe RecipeIngredient[]
  @@unique([productId, name])
}
model ProductTopping {
  id String @id @default(uuid())
  name String
  priceCents Int
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipe ToppingIngredient[]
  @@unique([productId, name])
}
model Order {
  id String @id @default(uuid())
  orderNumber String @unique
  userId String
  user User @relation(fields: [userId], references: [id])
  status OrderStatus @default(PENDING)
  subtotalCents Int
  discountCents Int @default(0)
  totalCents Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  payments Payment[]
  promotion Promotion? @relation(fields: [promotionId], references: [id])
  promotionId String?
  loyalty LoyaltyTransaction[]
  stockMovements StockMovement[]
  statusHistory OrderStatusHistory[]
  @@index([userId, createdAt])
}
model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  changedById String?
  changedBy   User?       @relation("OrderStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime    @default(now())

  @@index([orderId, changedAt])
}
model OrderItem {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  productName String
  size String
  toppings String[]
  quantity Int
  unitPriceCents Int
  lineTotalCents Int
  usesProductStock Boolean @default(true)
}
model Payment {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  idempotencyKey String 
  providerReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId, createdAt])
  @@unique([orderId, idempotencyKey])
}
model Promotion {
  id String @id @default(uuid())
  code String @unique
  discountPercent Int
  active Boolean @default(true)
  expiresAt DateTime?
  orders Order[]
}
model LoyaltyTransaction {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  orderId String?
  order Order? @relation(fields: [orderId], references: [id])
  type LoyaltyType
  points Int
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

enum IngredientUnit {
  ML
  G
  PIECE
}

enum StockMovementType {
  RECEIPT
  RESERVE
  RELEASE
}

model Ingredient {
  id String @id @default(uuid())
  code String @unique
  name String
  unit IngredientUnit
  available Int @default(0)
  sizes RecipeIngredient[]
  toppings ToppingIngredient[]
  movements StockMovement[]
}

model RecipeIngredient {
  sizeId String
  size ProductSize @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Int
  @@id([sizeId, ingredientId])
}

model ToppingIngredient {
  toppingId String
  topping ProductTopping @relation(fields: [toppingId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Int
  @@id([toppingId, ingredientId])
}

model StockMovement {
  id String @id @default(uuid())
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  orderId String?
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type StockMovementType
  quantity Int
  createdAt DateTime @default(now())
  @@index([ingredientId, createdAt])
  @@unique([orderId, ingredientId, type])
}
