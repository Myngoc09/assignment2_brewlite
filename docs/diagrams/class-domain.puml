@startuml
skinparam classAttributeIconSize 0

class User {
  id: UUID
  email: String
  name: String
  role: Role
}
class Product {
  id: UUID
  slug: String
  name: String
  active: Boolean
  inventory: Int
}
class ProductSize {
  name: String
  priceCents: Int
}
class ProductTopping {
  name: String
  priceCents: Int
}
class Order {
  id: UUID
  orderNumber: String
  status: OrderStatus
  subtotalCents: Int
  discountCents: Int
  totalCents: Int
  createdAt: DateTime
}
class OrderItem {
  productName: String
  size: String
  toppings: String[]
  quantity: Int
  unitPriceCents: Int
  lineTotalCents: Int
}
class Payment {
  id: UUID
  method: PaymentMethod
  status: PaymentStatus
  idempotencyKey: String
  providerReference: String?
}
class Promotion {
  code: String
  discountPercent: Int
  active: Boolean
  expiresAt: DateTime?
}
class LoyaltyTransaction {
  type: LoyaltyType
  points: Int
  createdAt: DateTime
}
class OrderStatusHistory {
  status: OrderStatus
  note: String?
  changedAt: DateTime
}

enum Role {
  CUSTOMER
  STAFF
  MANAGER
}
enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}
enum PaymentMethod {
  MOCK_WALLET
  MOCK_CARD
}
enum LoyaltyType {
  EARN
  REDEEM
}

User "1" -- "0..*" Order : places
User "1" -- "0..*" LoyaltyTransaction : earns
User "0..1" -- "0..*" OrderStatusHistory : changes
Product "1" *-- "0..*" ProductSize : offers
Product "1" *-- "0..*" ProductTopping : offers
Product "1" -- "0..*" OrderItem : ordered as
Order "1" *-- "1..*" OrderItem : contains
Order "1" -- "0..*" Payment : attempts
Order "1" *-- "0..*" OrderStatusHistory : tracks
Order "0..1" -- "0..*" LoyaltyTransaction : awards
Promotion "0..1" -- "0..*" Order : applies to

note bottom of Payment
  Unique key per order.
  At most one successful mock payment per order.
end note
@enduml
