@startuml BrewLite-Class-Diagram
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty methods

class User {
  +id: UUID
  +fullName: string
  +email: string
  +phone: string
  +passwordHash: string
  +role: UserRole
  +createdAt: datetime
}
class Product {
  +id: UUID
  +name: string
  +description: string
  +price: decimal
  +stockQuantity: int
  +isAvailable: boolean
}
class Order {
  +id: UUID
  +orderCode: string
  +status: OrderStatus
  +subtotal: decimal
  +discountAmount: decimal
  +totalAmount: decimal
  +deliveryAddress: string
  +createdAt: datetime
  +updatedAt: datetime
}
class OrderItem {
  +id: UUID
  +quantity: int
  +unitPrice: decimal
  +lineTotal: decimal
}
class Payment {
  +id: UUID
  +amount: decimal
  +method: PaymentMethod
  +status: PaymentStatus
  +transactionRef: string
  +paidAt: datetime
}
class Promotion {
  +id: UUID
  +code: string
  +description: string
  +discountType: DiscountType
  +discountValue: decimal
  +startsAt: datetime
  +endsAt: datetime
  +isActive: boolean
}
class LoyaltyTransaction {
  +id: UUID
  +points: int
  +type: LoyaltyTransactionType
  +description: string
  +createdAt: datetime
}
class OrderStatusHistory <<optional for order tracking>> {
  +id: UUID
  +status: OrderStatus
  +note: string
  +changedAt: datetime
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}
enum PaymentMethod {
  CASH
  CARD
  E_WALLET
}
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}
enum UserRole {
  CUSTOMER
  STAFF
  MANAGER
}
enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
}

User "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderItem : contains
Product "1" -- "0..*" OrderItem : ordered as
Order "1" -- "0..1" Payment : paid by
Promotion "0..1" -- "0..*" Order : applied to
User "1" -- "0..*" LoyaltyTransaction : owns
Order "1" *-- "0..*" OrderStatusHistory : status timeline
User "0..1" -- "0..*" OrderStatusHistory : changes

note bottom of OrderStatusHistory
  Optional extension for storing each status update
  displayed in the order tracking history.
end note
@enduml
