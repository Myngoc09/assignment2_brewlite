@startuml
autonumber "<b>0.#'.'</b>"
skinparam shadowing false
skinparam sequence {
    ArrowColor #37474F
    LifeLineBorderColor #0288D1
    LifeLineBackgroundColor #E1F5FE
    ParticipantBorderColor #0288D1
    ParticipantBackgroundColor #E1F5FE
    ActorBorderColor #0288D1
    ActorBackgroundColor #E1F5FE
}

actor "Khách hàng" as Customer
participant "Hệ thống" as System
database "Cơ sở dữ liệu" as DB

Customer -> System : Yêu cầu xem giỏ hàng
activate Customer
activate System

System -> DB : Lấy thông tin giỏ hàng
activate DB
DB --> System : Trả về danh sách sản phẩm
deactivate DB

System --> Customer : Hiển thị giỏ hàng
deactivate System
deactivate Customer

Customer -> System : Chọn Đặt hàng
activate Customer
activate System

System --> Customer : Hiển thị form giao hàng
deactivate System
deactivate Customer

Customer -> System : Nhập thông tin giao hàng
activate Customer
activate System

System -> System : Kiểm tra thông tin giao hàng

alt Thông tin không hợp lệ
    System --> Customer : Thông báo lỗi
else Thông tin hợp lệ
    System -> DB : Kiểm tra số lượng tồn kho
    activate DB
    DB --> System : Trả về kết quả
    deactivate DB

    alt Không đủ hàng
        System --> Customer : Thông báo không đủ hàng
    else Đủ hàng
        System -> DB : Tạo đơn hàng (PENDING)
        activate DB
        DB --> System : Xác nhận tạo đơn hàng

        System -> DB : Cập nhật số lượng tồn kho
        DB --> System : Xác nhận cập nhật

        System -> DB : Xóa sản phẩm trong giỏ hàng
        DB --> System : Xác nhận xóa giỏ hàng
        deactivate DB

        System --> Customer : Đặt hàng thành công
    end
end
deactivate System
deactivate Customer

@enduml